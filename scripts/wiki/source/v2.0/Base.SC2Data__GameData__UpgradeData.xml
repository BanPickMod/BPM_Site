    <!-- v1.4.3 balance: Firebat Napalm Ammo - +5 dmg vs Light, +2 range,
         modest attack-period reduction ("공격 딜레이 감소" - no exact figure
         given in the design doc, implemented as roughly 15% off the
         current 1.3125s period). -->
    <CUpgrade id="BPM_FirebatNapalmAmmo">
        <Name value="Upgrade/Name/BPM_FirebatNapalmAmmo"/>
        <Icon value="Assets\Textures\btn-upgrade-terran-napalmammo.dds"/>
        <EditorCategories value="Race:Terran,UpgradeType:SpellResearch"/>
        <EffectArray Operation="Add" Reference="Effect,BPM_FirebatSCBWWeapon@DamageAccum,AttributeBonus[Light]" Value="5"/>
        <!-- Keep the info-panel display effect (DamageConc) in sync with the
             real damage effect above, or the panel would still show the
             pre-research +4 after Napalm Ammo completes. -->
        <EffectArray Operation="Add" Reference="Effect,BPM_FirebatSCBWWeapon@DamageConc,AttributeBonus[Light]" Value="5"/>
        <!-- Firebat equips the hidden Melee variant before the visible base
             weapon, and uses the Bunker variant while transported. Catalog
             upgrade overlays do not propagate from a parent weapon entry to
             its already-resolved child entries, so update all three. -->
        <EffectArray Operation="Add" Reference="Weapon,BPM_FirebatSCBWWeapon,Range" Value="2"/>
        <EffectArray Operation="Add" Reference="Weapon,BPM_FirebatSCBWWeapon,Period" Value="-0.2"/>
        <EffectArray Operation="Add" Reference="Weapon,BPM_FirebatSCBWWeapon@Melee,Range" Value="2"/>
        <EffectArray Operation="Add" Reference="Weapon,BPM_FirebatSCBWWeapon@Melee,Period" Value="-0.2"/>
        <EffectArray Operation="Add" Reference="Weapon,BPM_FirebatSCBWWeapon@Bunker,Range" Value="2"/>
        <EffectArray Operation="Add" Reference="Weapon,BPM_FirebatSCBWWeapon@Bunker,Period" Value="-0.2"/>
    </CUpgrade>
    <!-- v1.4.3 balance: Firebat + Marauder Infantry Heavy Armor - shared
         research, +25 life and reverts both units from Light back to
         Armored. Mutually exclusive in practice with Napalm Ammo /
         Shatter Shells per the design doc's note (players pick one path).
         Fix: this used to try to flip Attributes[Light]/[Armored] via
         EffectArray directly, which never worked in-game (SC2 has no
         supported way to toggle a live unit's attribute flags via an
         upgrade). Now a bare tech-tree flag - the actual +25 life and
         Armored reclassification happen by morphing into
         BPM_FirebatHeavyArmor/BPM_MarauderHeavyArmor (UnitData.xml),
         triggered by BPM_InitInfantryHeavyArmorTrigger in
         BPM_Core_Init.galaxy the instant this upgrade completes (and for
         any Firebat/Marauder trained afterward). -->
    <CUpgrade id="BPM_TerranInfantryHeavyArmor">
        <Name value="Upgrade/Name/BPM_TerranInfantryHeavyArmor"/>
        <Icon value="Assets\Textures\btn-upgrade-terran-infantryheavyarmor.dds"/>
        <EditorCategories value="Race:Terran,UpgradeType:SpellResearch"/>
    </CUpgrade>
