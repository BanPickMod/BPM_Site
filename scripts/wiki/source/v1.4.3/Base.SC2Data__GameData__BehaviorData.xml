<Catalog>
    <!-- v1.4.3 balance: facing correction used to run off this behavior's own
         PeriodicEffect, which fired independently of the weapon's own
         effect chain and had no real Target/TargetPoint of its own - the
         cross-reference to BPM_FirebatSCBWWeapon@FacingOffset (a persistent
         created purely at the caster's own location) resolved back to the
         caster instead of the real target, spinning the Firebat 180 degrees
         instead of facing the enemy. Facing is now driven directly from
         BPM_FirebatSCBWWeapon@CP's own periodic chain (see
         BPM_FirebatSCBWWeapon@Impact in EffectData.xml), which has the real
         target naturally available, so this behavior only needs to
         immobilize the caster while it channels. -->
    <CBehaviorBuff id="BPM_FirebatSCBWWeapon@SuppressMovement">
        <EditorCategories value="AbilityorEffectType:Units,Race:Terran" />
        <Duration value="0.6562" />
        <Modification MoveSpeedMaximum="0.004" AccelerationMultiplier="0.01">
            <ModifyFlags index="OrdersUninterruptible" value="1" />
        </Modification>
        <InfoFlags index="Hidden" value="1" />
    </CBehaviorBuff>
    <CBehaviorBuff id="BPM_FirebatSCBWWeapon@Bunker">
        <EditorCategories value="AbilityorEffectType:Units,Race:Terran"/>
        <DisableValidatorArray value="NotInsideTransport"/>
        <Modification>
            <WeaponEnableArray value="BPM_FirebatSCBWWeapon@Bunker"/>
            <WeaponDisableArray value="BPM_FirebatSCBWWeapon"/>
        </Modification>
    </CBehaviorBuff>
