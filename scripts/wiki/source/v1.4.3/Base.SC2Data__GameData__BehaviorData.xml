    <!-- Defiler Dark Swarm: DamageResponse is a singleton, not an indexed
         array. Use one inherited behavior per damage kind so ranged and
         melee attacks can have independent reduction fractions. -->
    <CBehaviorBuff id="DefilerMPDarkSwarm">
        <EditorCategories value="AbilityorEffectType:Units,Race:Zerg"/>
        <Duration value="0.35"/>
        <BuffFlags index="RefreshStack" value="1"/>
        <DamageResponse ModifyFraction="0.5" ModifyMinimumDamage="0">
            <Chance value="1"/>
            <Kind index="Ranged" value="1"/>
        </DamageResponse>
        <!-- This protection is refreshed every 0.25s while inside the cloud.
             Do not expose that implementation timer as an overhead bar. -->
        <DisplayDuration index="Self" value="0"/>
        <DisplayDuration index="Ally" value="0"/>
    </CBehaviorBuff>
    <CBehaviorBuff id="BPM_DefilerMPDarkSwarmMelee" parent="DefilerMPDarkSwarm">
        <DamageResponse ModifyFraction="0.7" ModifyMinimumDamage="0">
            <Chance value="1"/>
            <Kind index="Ranged" value="0"/>
            <Kind index="Melee" value="1"/>
        </DamageResponse>
    </CBehaviorBuff>
    <!-- v1.4.3 balance: Crucio Suppressor - reduces Siege Tank's friendly fire damage by 75% -->
    <CBehaviorBuff id="BPM_CrucioSuppressorBehavior">
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="AbilityorEffectType:Units,Race:Terran"/>
        <Requirements value="BPM_Req_CrucioSuppressorResearched"/>
        <!-- Alliance flags in the positive half are conjunctive.  Requiring
             Player and Ally together never matches, so admit both by excluding
             every non-friendly relationship instead. -->
        <DamageResponse Location="Attacker" ModifyFraction="0.25" ModifyMinimumDamage="0" TargetFilters="-;Self,Neutral,Enemy,Missile,Stasis,Dead,Hidden,Invulnerable">
            <Kind index="NoProc" value="0"/>
            <Chance value="1"/>
        </DamageResponse>
    </CBehaviorBuff>
    <!-- v1.5 / balance: Irradiate duration reduced from 30s game time (21.4s on Faster)
         to 21s game time (15.0s on Faster). -->
    <CBehaviorBuff id="Irradiate">
