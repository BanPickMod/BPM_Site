    <!-- Warp-in Zero Shield Lock in Energizer Power Field -->
    <CBehaviorBuff id="BPM_EnergizerWarpInZeroShieldBuff">
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="Race:Protoss,AbilityorEffectType:Units"/>
        <Duration value="0.5"/>
        <BuffFlags index="RefreshStack" value="1"/>
        <InitialEffect value="BPM_EnergizerWarpInZeroShields"/>
        <PeriodicEffect value="BPM_EnergizerWarpInZeroShields"/>
        <Period value="0.0625"/>
        <FinalEffect value="BPM_EnergizerWarpInZeroShields"/>
        <Modification>
            <VitalRegenArray index="Shields" value="-100"/>
            <ShieldRegenDelay value="10"/>
        </Modification>
    </CBehaviorBuff>
